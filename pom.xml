<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.opentripplanner</groupId>
    <artifactId>graphql-codegen</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>GraphQL code generator</name>
    <description>
        Build-time tool that generates Java types and data fetcher interfaces for a GraphQL API
        from its schema.
    </description>
    <url>https://github.com/opentripplanner/graphql-codegen</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>OpenTripPlanner Project</name>
        <url>https://www.opentripplanner.org</url>
    </organization>

    <developers>
        <developer>
            <name>OpenTripPlanner Project</name>
            <organization>OpenTripPlanner Project</organization>
            <organizationUrl>https://www.opentripplanner.org</organizationUrl>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/opentripplanner/graphql-codegen</url>
        <connection>scm:git:https://github.com/opentripplanner/graphql-codegen.git</connection>
        <developerConnection>scm:git:git@github.com:opentripplanner/graphql-codegen.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/opentripplanner/graphql-codegen/issues</url>
    </issueManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <!-- Lib versions - keep list sorted on property name -->
        <graphql-java.version>26.1</graphql-java.version>
        <jackson.version>3.2.3</jackson.version>
        <javapoet.version>0.22.0</javapoet.version>
        <junit.version>6.1.3</junit.version>

        <!-- Formatting. Use '-Dplugin.spotless.goal=check' to only verify the formatting. -->
        <plugin.spotless.version>3.10.4</plugin.spotless.version>
        <plugin.spotless.goal>apply</plugin.spotless.goal>
        <plugin.spotless.skip>false</plugin.spotless.skip>
        <!-- The npm packages used by the Spotless 'prettier' step. Keep them in sync with each
             other; prettier-plugin-java only supports a limited range of prettier versions. -->
        <prettier.version>3.9.6</prettier.version>
        <prettier.java.version>2.10.3</prettier.java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 3rd party dependencies -->
        <dependency>
            <groupId>com.graphql-java</groupId>
            <artifactId>graphql-java</artifactId>
            <version>${graphql-java.version}</version>
        </dependency>
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.palantir.javapoet</groupId>
            <artifactId>javapoet</artifactId>
            <version>${javapoet.version}</version>
        </dependency>

        <!-- test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!--
                  Spotless runs Prettier (with the prettier-java plugin) to format the code, using
                  the same style as OpenTripPlanner.
                  Note! Spotless requires node/npm to be available on the PATH.
                -->
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${plugin.spotless.version}</version>
                <configuration>
                    <skip>${plugin.spotless.skip}</skip>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <removeUnusedImports>
                            <engine>cleanthat-javaparser-unnecessaryimport</engine>
                        </removeUnusedImports>
                        <prettier>
                            <devDependencies>
                                <prettier>${prettier.version}</prettier>
                                <prettier-plugin-java>${prettier.java.version}</prettier-plugin-java>
                            </devDependencies>
                            <config>
                                <plugins>prettier-plugin-java</plugins>
                                <parser>java</parser>
                                <printWidth>100</printWidth>
                                <tabWidth>2</tabWidth>
                                <useTabs>false</useTabs>
                                <endOfLine>lf</endOfLine>
                            </config>
                        </prettier>
                    </java>
                    <formats>
                        <format>
                            <includes>
                                <include>*.md</include>
                            </includes>
                            <prettier>
                                <devDependencies>
                                    <prettier>${prettier.version}</prettier>
                                </devDependencies>
                                <config>
                                    <parser>markdown</parser>
                                    <proseWrap>always</proseWrap>
                                    <printWidth>100</printWidth>
                                </config>
                            </prettier>
                        </format>
                    </formats>
                </configuration>
                <executions>
                    <execution>
                        <id>prettier-format</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>${plugin.spotless.goal}</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
            </plugin>
        </plugins>
    </build>
</project>
